{
  "name": "clario-api",
  "version": "0.1.0",
  "description": "Clario dual-spec API: MCP server (Claude) + OpenAPI (ChatGPT Actions) from one codebase",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:mcp": "TRANSPORT=stdio tsx src/index.ts",
    "test": "vitest run",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc --noEmit",
    "quality": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.4.0",
    "hono": "^4.4.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
