# ── Local user ─────────────────────────────────────────────────
# Clario is local-first: there are no accounts. This UUID identifies you
# on this device and must be a member of the groups in your ledger.
CLARIO_USER_ID=00000000-0000-0000-0000-000000000001

# ── Ledger ─────────────────────────────────────────────────────
# Optional JSON file that persists the local ledger across restarts.
# Omit to keep the ledger in memory only.
LEDGER_FILE=./clario-ledger.json

# ── Server ────────────────────────────────────────────────────
PORT=3000
# Transport: "http" (OpenAPI) or "stdio" (MCP Claude Desktop)
TRANSPORT=http
# Public URL advertised in the OpenAPI spec (e.g. a tunnel URL for ChatGPT).
# Defaults to http://localhost:$PORT.
# PUBLIC_API_URL=https://your-tunnel.example.com

# ── Auth ──────────────────────────────────────────────────────
# Simple API key auth for OpenAPI (ChatGPT Actions)
# Set this in your Custom GPT's Action authentication settings
API_SECRET_KEY=your-random-secret-key-here

# ── CORS ──────────────────────────────────────────────────────
# Add ChatGPT's domain so GPT Actions can call your API
ALLOWED_ORIGINS=https://chat.openai.com,https://chatgpt.com
