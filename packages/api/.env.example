# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# ── Server ────────────────────────────────────────────────────
PORT=3000
# Transport: "http" (OpenAPI + MCP-over-HTTP) or "stdio" (MCP Claude Desktop)
TRANSPORT=http

# ── Auth ──────────────────────────────────────────────────────
# Simple API key auth for OpenAPI (ChatGPT Actions)
# Set this in your Custom GPT's Action authentication settings
API_SECRET_KEY=your-random-secret-key-here

# ── CORS ──────────────────────────────────────────────────────
# Add ChatGPT's domain so GPT Actions can call your API
ALLOWED_ORIGINS=https://chat.openai.com,https://chatgpt.com
