# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# ── MCP local mode (Claude Desktop) ───────────────────────────
# Your Supabase user UUID — find it in Supabase Dashboard > Authentication > Users
# This identifies you when the MCP server runs locally (no JWT needed).
CLARIO_USER_ID=your-supabase-user-uuid

# ── Storage ────────────────────────────────────────────────────
# Supabase Storage bucket name for receipt uploads.
# Run the 002_storage.sql migration to create it.
SUPABASE_STORAGE_BUCKET=receipts

# ── Server ────────────────────────────────────────────────────
PORT=3000
# Transport: "http" (OpenAPI + MCP-over-HTTP) or "stdio" (MCP Claude Desktop)
TRANSPORT=http

# ── Auth ──────────────────────────────────────────────────────
# Simple API key auth for OpenAPI (ChatGPT Actions)
# Set this in your Custom GPT's Action authentication settings
API_SECRET_KEY=your-random-secret-key-here

# ── CORS ──────────────────────────────────────────────────────
# Add ChatGPT's domain so GPT Actions can call your API
ALLOWED_ORIGINS=https://chat.openai.com,https://chatgpt.com
